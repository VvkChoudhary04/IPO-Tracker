{
  "name": "ipotrack-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "IPOTrack - Automated Indian IPO allotment tracking platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@ipotrack/web",
    "dev:api": "npm run dev --workspace=@ipotrack/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}

