# ==============================================================================
# IPOTrack Backend API - Environment Configuration Template
# Copy this file to `apps/api/.env` and replace placeholders with your credentials.
# ==============================================================================

# Server Network Settings
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api

# ------------------------------------------------------------------------------
# Supabase Project Configuration (Mumbai Region: ap-south-1)
# Find these in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL: e.g. https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key (used for basic verification fallback)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret Service Role Key (CRITICAL: Server-side only; NEVER expose to client)
# Used by backend to verify user tokens and manage data bypasses RLS safely
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database URLs
# Find these in Supabase Dashboard -> Project Settings -> Database -> Connection Strings
# ------------------------------------------------------------------------------
# Transaction Pooler (Port 6543) - Used for high-throughput API runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Session Connection (Port 5432) - Required by Prisma to run schema migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Server-Side Cryptographic Keys (AES-256-GCM & Blind Indexing)
# Generate each using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
# 64-character hex string (32 bytes) for AES-256-GCM PAN encryption at rest
PAN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 64-character hex string (32 bytes) for HMAC-SHA256 blind index duplicate detection
PAN_BLIND_INDEX_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
