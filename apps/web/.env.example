# ==============================================================================
# IPOTrack Frontend Web - Environment Configuration Template
# Copy this file to `apps/web/.env` and replace placeholders with your credentials.
# ==============================================================================

# Backend API Engine URL
VITE_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# Supabase Client Configuration
# Find these in Supabase Dashboard -> Project Settings -> API
# SECURITY NOTE: ONLY provide the public URL and ANON key here.
# NEVER place SUPABASE_SERVICE_ROLE_KEY or database connection strings in this file.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
